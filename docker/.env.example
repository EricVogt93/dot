# Copy to docker/.env and adjust. All values are optional.

# Codex CLI release baked into the image at build time.
# CODEX_VERSION=0.167.0

# Image tag used by `docker compose build`.
# DOT_IMAGE=dot:local

# Visible device name in ChatGPT (container hostname). Set before first start.
# DOT_HOSTNAME=dot-sandbox

# Host port (published on 127.0.0.1 only).
# DOT_PORT=8787

# Host directory mounted at /workspace.
# DOT_WORKSPACE_HOST=./workspace

# Existing Codex auth.json used as a one-time seed.
# DOT_AUTH_FILE=/home/you/.codex/auth.json

# Bearer token for the HTTP API. Required for anything beyond loopback.
# DOT_API_KEY=change-me

# Comma-separated browser origins allowed to call the API (CORS).
# DOT_CORS_ORIGINS=http://localhost:3000

# Model passed to thread/start (defaults to the Codex default).
# DOT_MODEL=

# Pass --analytics-default-enabled to the Codex app-server (0/1).
# DOT_ANALYTICS=0

# Experimental ChatGPT Dots/Work connector (0/1). See docs/dots-executor.md.
# DOT_DOTS_EXECUTOR=0

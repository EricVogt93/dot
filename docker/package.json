{
  "name": "dotcker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible HTTP bridge and remote-control container for the Codex app-server",
  "license": "Apache-2.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/helpers.test.js test/bridge.test.js test/lifecycle.test.js test/supervisor.test.js",
    "test:unit": "node --test test/helpers.test.js",
    "test:bridge": "node --test test/bridge.test.js test/lifecycle.test.js",
    "test:supervisor": "node --test test/supervisor.test.js",
    "test:image": "bash verify-image.sh",
    "lint": "node --check server.js && bash -n entrypoint.sh && bash -n dots-executor.sh && bash -n remote-control.sh"
  },
  "engines": {
    "node": ">=22"
  }
}